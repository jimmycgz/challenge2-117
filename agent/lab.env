# Settings for the Chicago food broker in the hackathon lab project. No secrets: no keys, tokens or passwords.
# Load into a shell with:  set -a; source agent/lab.env; set +a
# deploy.sh reads this file for any setting you have not already set. The lab project is temporary.
# To use your own project, change the first four lines (see "Reproduce it in your own project" in the agent README).
GOOGLE_CLOUD_PROJECT=qwiklabs-gcp-04-6c7101c1dba1
A4I_EXPECTED_PROJECT=qwiklabs-gcp-04-6c7101c1dba1
A4I_EXPECTED_PROJECT_NUMBER=817377390808
A4I_EXPECTED_PRINCIPAL_SUFFIX=@qwiklabs.net
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_LOCATION=global
A4I_MODEL=gemini-3.8-flash
A4I_THINKING_LEVEL=LOW
A4I_DATASET=a4i_food
A4I_METRO=Chicago
A4I_MCP=1
